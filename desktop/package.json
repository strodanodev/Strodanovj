{
  "name": "strodano-vj",
  "productName": "Strodano VJ",
  "version": "0.4.5",
  "description": "Strodano VJ: live visuals, VJ and DJ in one app",
  "main": "main.js",
  "license": "GPL-3.0-only",
  "author": "Strodano",
  "homepage": "https://github.com/strodanodev/Strodanovj",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "pro": "node ../tools/pro.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "43.8.10",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.5"
  },
  "build": {
    "appId": "dev.strodano.vj",
    "productName": "Strodano VJ",
    "copyright": "GPL-3.0. Uses three.js (MIT) and MediaPipe (Apache-2.0).",
    "directories": {
      "output": "dist",
      "buildResources": "res"
    },
    "files": [
      "main.js",
      "preload.js",
      "ndi.js",
      "ndi-worker.js",
      "ndinet.js",
      "power.js",
      "updater.js",
      "rekordbox.js",
      "pro.js",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/!(${platform}_${arch})/**",
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!**/*.md",
          "!pro/**"
        ]
      }
    ],
    "asarUnpack": [
      "ndi-worker.js",
      "node_modules/koffi/**",
      "web/stock/**"
    ],
    "artifactName": "StrodanoVJ-${version}-${os}-${arch}.${ext}",
    "afterPack": "afterpack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "res/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Strodano VJ",
      "include": "res/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "publish": null,
      "category": "public.app-category.entertainment",
      "icon": "res/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Strodano VJ shows your camera as a clip and follows your hands and movement to drive the visuals.",
        "NSMicrophoneUsageDescription": "Strodano VJ can listen to the music in the room to follow its beat."
      },
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Strodano VJ ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "strodanodev",
      "repo": "Strodanovj"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.16.4"
  }
}
